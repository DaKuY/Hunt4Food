# Optional: inject at build time for Google star ratings.
# Restrict this key to HTTP referrers (Hunt4Food.andrewcamero.com) in Google Cloud Console.
# You can also add a key in the app Settings page (stored in your browser only).
VITE_GOOGLE_PLACES_API_KEY=

# Optional override for Yelp/TripAdvisor proxy (built into the app by default).
VITE_RATINGS_PROXY_URL=

# Lodge auth (server-only — never prefix these with VITE_)
# Must match the andrewcamero.com lodge AUTH_SECRET.
AUTH_SECRET=

# Production cookie domain used by the lodge when it sets ac_session.
COOKIE_DOMAIN=.andrewcamero.com

# Lodge origin (local: http://localhost:3000)
LODGE_ORIGIN=https://andrewcamero.com

# Catalog slug this product checks for on the session apps[] grant list.
APP_SLUG=Hunt4Food
