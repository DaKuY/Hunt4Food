# Preferred: server-only provider keys used by /api/discover and ratings enrichment.
# Configure these in Vercel for Production + Preview; never expose them to the browser.
GOOGLE_PLACES_API_KEY=
YELP_API_KEY=

# Google Maps for the area picker and results map (Maps JavaScript API, browser key).
# Free up to 10,000 map loads a month. Restrict the key to HTTP referrer
# https://hunt4food.andrewcamero.com/* and to the Maps JavaScript API only.
# Without it, Hunt4Food shows the OpenStreetMap map instead.
VITE_GOOGLE_MAPS_API_KEY=
# Map ID for the numbered pins (Cloud Console → Map Management → Create, JavaScript, Vector). Free.
VITE_GOOGLE_MAPS_MAP_ID=

# Optional: inject at build time for Google star ratings.
# Restrict this key to HTTP referrers (hunt4food.andrewcamero.com) in Google Cloud Console.
# You can also add a key in the app Settings page (stored in your browser only).
VITE_GOOGLE_PLACES_API_KEY=

# Optional override for Yelp/TripAdvisor proxy (built into the app by default).
VITE_RATINGS_PROXY_URL=

# Base Camp is the only verifier of ac_session. Never add AUTH_SECRET to this project.

# Production cookie domain used by the lodge when it sets ac_session.
COOKIE_DOMAIN=.andrewcamero.com

# Lodge origin (local: http://localhost:3000)
LODGE_ORIGIN=https://andrewcamero.com

# Catalog slug. Hunt4Food is open to every signed-in member (no grant check).
APP_SLUG=Hunt4Food
